# ── Datastores (docker-compose) ─────────────────────────────
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos_secret
POSTGRES_DB=pos
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── API ─────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://pos:pos_secret@localhost:5432/pos?schema=public
REDIS_URL=redis://localhost:6379

# Auth secrets — CHANGE THESE in any real environment
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=900        # seconds (15m)
JWT_REFRESH_TTL=1209600   # seconds (14d)

# CORS allowlist (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
